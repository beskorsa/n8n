  "nodes": [
    {
      "id": "webhook",
      "name": "Log Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "path": "log-event",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "c12a28eb-9c7b-4d3b-9f49-51c82bdf597a"
    },
    {
      "id": "search_webhook",
      "name": "Search Events Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "path": "search-events",
        "httpMethod": "GET",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "a67e47ac-ce12-4b4b-8006-5d5fe5bb83ab"
    },
    {
      "id": "format_log",
      "name": "Format Log Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        200
      ],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "timestamp",
              "stringValue": "={{ $now.toISO() }}"
            },
            {
              "name": "service",
              "stringValue": "={{ $json.body.service }}"
            },
            {
              "name": "action",
              "stringValue": "={{ $json.body.action }}"
            },
            {
              "name": "user_id",
              "stringValue": "={{ $json.body.user_id || 'system' }}"
            },
            {
              "name": "details",
              "stringValue": "={{ JSON.stringify($json.body.details || {}) }}"
            },
            {
              "name": "status",
              "stringValue": "={{ $json.body.status || 'success' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sheets_log",
      "name": "Append to Logs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        200
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "event_logs"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [
            "timestamp",
            "service",
            "action",
            "user_id",
            "details",
            "status"
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sheets_search",
      "name": "Search Logs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        460,
        400
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "event_logs"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "service",
              "lookupValue": "={{ $json.query.service }}"
            },
            {
              "lookupColumn": "action",
              "lookupValue": "={{ $json.query.action }}"
            }
          ]
        },
        "options": {
          "rangeDefinition": "specifyRange",
          "range": "A:F"
        }
      }
    },
    {
      "id": "respond_search",
      "name": "Return Search Results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"results\": $json, \"count\": $json.length } }}",
        "options": {}
      }
    }
  ],
