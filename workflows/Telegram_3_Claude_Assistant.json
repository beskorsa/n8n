        }
      }
    },
    {
      "id": "prepare",
      "name": "Prepare Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1180,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "chat",
              "name": "chat_id",
              "value": "={{$json.message.chat.id}}",
              "type": "number"
            },
            {
              "id": "user",
              "name": "user_id",
              "value": "={{$json.message.from.id}}",
              "type": "number"
            },
            {
              "id": "text",
              "name": "user_text",
              "value": "={{$json.message.text || ''}}",
              "type": "string"
            },
            {
              "id": "session",
              "name": "session_key",
              "value": "={{String($json.message.chat.id)}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "history",
      "name": "Get Conversation History",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -920,
        -220
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "conversations",
        "limit": 30,
        "filters": {
          "conditions": [
            {
              "keyName": "session_key",
              "condition": "eq",
              "keyValue": "={{$node['Prepare Input'].json.session_key}}"
            }
          ]
        },
        "options": {
          "alwaysOutputData": true
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "VTlk7ZqsgA8HfKQ1",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "history-format",
      "name": "Format History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        -220
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.role && typeof r.content === 'string');\nrows.sort((a,b) => new Date(a.created_at) - new Date(b.created_at));\nreturn [{json:{history:rows.slice(-30).map(r => ({role:r.role,content:r.content}))}}];"
      }
    },
    {
      "id": "embedding",
      "name": "Create Query Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -920,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"input\":$node['Prepare Input'].json.user_text,\"model\":\"text-embedding-3-small\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4U8BHxx4KVs0sXjj",
          "name": "Header Auth account"
        }
      }
    },
    {
      "id": "rpc",
      "name": "Match Solutions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lylithbecmmitspgeddh.supabase.co/rest/v1/rpc/match_solutions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"query_embedding\":$json.data[0].embedding,\"match_count\":10,\"match_threshold\":0.2}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4U8BHxx4KVs0sXjj",
          "name": "Header Auth account"
        }
      }
    },
    {
      "id": "solutions-format",
      "name": "Format Solutions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        220
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.problem || r.solution);\nreturn [{json:{solutions:rows.map(r => ({problem:r.problem,solution:r.solution,tags:r.tags,similarity:r.similarity ?? r.match_score}))}}];"
      }
    },
    {
      "id": "merge",
      "name": "Merge History and Solutions",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "id": "context",
      "name": "Build Claude Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const history = $json.history ?? [];\nconst solutions = $json.solutions ?? [];\nconst input = $('Prepare Input').first().json;\nconst ctx = 'History: ' + JSON.stringify(history) + ' Solutions: ' + JSON.stringify(solutions);\nreturn [{json:{...input,context:ctx}}];"
      }
    },
    {
      "id": "claude",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 2048, system: 'You are a Telegram assistant for a developer. You have a knowledge base of past solutions. Use relevant solutions when applicable and adapt them to the question, not verbatim. If none are relevant, answer in your own words and do not invent project details. Be concise, answer in the user language, and ask before irreversible actions.', messages: [{ role: 'user', content: $json.context + ' Current user message: ' + $json.user_text }] }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "4U8BHxx4KVs0sXjj",
          "name": "Header Auth account"
        }
      }
    },
    {
      "id": "extract",
      "name": "Extract Claude Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "jsCode": "if ($json.error) return [{json:{ok:false,error:$json.error.message || JSON.stringify($json.error)}}];\nconst block = ($json.content || []).find(b => b.type === 'text' && typeof b.text === 'string');\nreturn block ? [{json:{ok:true,answer:block.text}}] : [{json:{ok:false,error:'Claude returned no text block'}}];"
      }
    },
    {
      "id": "if",
      "name": "Claude Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.ok}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "send-error",
