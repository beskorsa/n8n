                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.input_format }}",
                    "rightValue": "xml",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "from_xml"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "parse_json",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        180
      ],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "parsed",
              "stringValue": "={{ JSON.parse($json.body.data) }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "parse_csv",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const csv = $input.first().json.body.data;\nconst lines = csv.split('\\n');\nconst headers = lines[0].split(',');\nconst items = lines.slice(1).map(line => {\n  const values = line.split(',');\n  return headers.reduce((obj, header, i) => {\n    obj[header.trim()] = values[i]?.trim();\n    return obj;\n  }, {});\n});\nreturn items.map(item => ({ json: item }));"
      }
    },
    {
      "id": "parse_xml",
      "name": "Parse XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1.1,
      "position": [
        680,
        420
      ],
      "parameters": {
        "mode": "xmlToJson",
        "options": {}
      }
    },
    {
      "id": "convert",
      "name": "Convert to Target Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const targetFormat = $input.first().json.body.output_format || 'json';\nconst data = $input.all().map(i => i.json.parsed || i.json);\n\nlet output;\nif (targetFormat === 'json') {\n  output = JSON.stringify(data, null, 2);\n} else if (targetFormat === 'csv') {\n  const headers = Object.keys(data[0]);\n  const csv = [headers.join(','), ...data.map(row => headers.map(h => row[h]).join(','))].join('\\n');\n  output = csv;\n} else if (targetFormat === 'xml') {\n  const xml = '<?xml version=\"1.0\"?><root>' + data.map(item => '<item>' + Object.entries(item).map(([k,v]) => `<${k}>${v}</${k}>`).join('') + '</item>').join('') + '</root>';\n  output = xml;\n}\n\nreturn [{ json: { output, format: targetFormat } }];"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"converted_data\": $json.output, \"format\": $json.format } }}",
        "options": {}
      }
    }
  ],
