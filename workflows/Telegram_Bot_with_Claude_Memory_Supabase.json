{
  "updatedAt": "2026-09-14T16:32:53.722Z",
  "createdAt": "2026-09-14T16:32:53.722Z",
  "id": "IT2UH08623xPHkh1",
  "name": "Telegram Bot with Claude + Memory (Supabase)",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "updates": [
          "message"
        ]
      }
    },
    {
      "id": "typing",
      "name": "Show Typing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "sendChatAction",
        "chatId": "={{ $json.message.chat.id }}",
        "action": "typing"
      }
    },
    {
      "id": "agent",
      "name": "Claude AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        680,
        300
      ],
      "parameters": {
        "prompt": "You are a helpful AI assistant. Remember context from previous messages in this conversation.",
        "options": {
          "systemMessage": "={{ $json.prompt }}"
        }
      }
    },
    {
      "id": "claude",
      "name": "Claude 3.7 Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.1,
      "position": [
        900,
        180
      ],
      "parameters": {
        "model": "claude-3-7-sonnet-20250219",
        "options": {
          "temperature": 0.7
        }
      }
    },
    {
      "id": "memory",
      "name": "Supabase Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.1,
      "position": [
        900,
        260
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "tableName": "telegram_chat_memory"
      }
    },
    {
      "id": "send",
      "name": "Send Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        380
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Show Typing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Show Typing": {
      "main": [
        [
          {
            "node": "Claude AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude AI Agent": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "ai_languageModel": [
        [
          {
            "node": "Claude 3.7 Sonnet",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ],
      "ai_memory": [
        [
          {
            "node": "Supabase Chat Memory",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
