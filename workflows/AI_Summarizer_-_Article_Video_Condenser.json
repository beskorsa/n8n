{
  "updatedAt": "2026-09-14T16:31:40.689Z",
  "createdAt": "2026-09-14T16:31:40.689Z",
  "id": "e40r4P5riqyqg3n5",
  "name": "AI Summarizer - Article & Video Condenser",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "summarize",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "487bc62e-8573-470a-ab24-59d0a129a6b4"
    },
    {
      "id": "switch",
      "name": "Content Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.url }}",
                    "rightValue": "youtube.com|youtu.be",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "video"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.url }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "exists"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "article"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "http_article",
      "name": "Fetch Article",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.url }}",
        "options": {}
      }
    },
    {
      "id": "http_video",
      "name": "Get Video Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.youtube.com/watch?v={{ $json.body.url.split('v=')[1] || $json.body.url.split('/').pop() }}",
        "options": {}
      }
    },
    {
      "id": "summarize_article",
      "name": "Summarize Article",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.5,
      "position": [
        900,
        200
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "Summarize the following article in 3-5 bullet points, focusing on key takeaways:\n\n{{ $json.data }}",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "summarize_video",
      "name": "Summarize Video",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.5,
      "position": [
        900,
        400
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "Summarize the following video content in 3-5 bullet points:\n\n{{ $json.data }}",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "merge",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      }
    },
    {
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"summary\": $json.output, \"url\": $('Webhook Trigger').item.json.body.url, \"timestamp\": $now.toISO() } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Content Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Content Type": {
      "main": [
        [
          {
            "node": "Fetch Article",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get Video Transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Article": {
      "main": [
        [
          {
            "node": "Summarize Article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Video Transcript": {
      "main": [
        [
          {
            "node": "Summarize Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Article": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Video": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Results": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
